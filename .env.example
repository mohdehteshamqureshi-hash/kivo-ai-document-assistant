# Kivo AI — Intelligent RAG-Based Document Assistant
# Root Environment Variables Configuration Example

# -----------------------------------------------------------------------------
# Netlify Deployment Environment Variables (Configure in Netlify Site Settings)
# -----------------------------------------------------------------------------
# Groq API Key (Server-side only — never exposed to client or browser bundle)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Local Development (Optional Overrides)
# -----------------------------------------------------------------------------
# Frontend API Base URL (defaults to '/api' for same-domain Netlify proxy/functions)
# VITE_API_URL=/api

# Python FastAPI Backend (Local Dev on port 8000)
# HOST=127.0.0.1
# PORT=8000
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
