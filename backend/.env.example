# Kivo AI Backend Environment Variables

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*

# RAG & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=350
CHUNK_OVERLAP=50
MAX_FILE_SIZE_MB=25
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.10

# Local LLM Runtime (Ollama - default: llama3.2:3b on localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=30

# AI Provider: Groq Cloud API (Recommended Cloud Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Cloud LLM Keys (Used only if Ollama/Groq are unavailable and keys are provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
